# ==================== v6 参数（2026-10-19 外置化，全部可在 .env 调整；改后需重启服务生效） ====================
# 来源：概念落地设计单_v1.md（v1.1）+ 用户铁律（2026-10-19）。缺省或删除本组键时程序按同值默认回退，行为不变。
# 调参验证：test_okx_strategy.TestEnvTuning（环境变量注入 → 生效值 / 触发点随动）。

# 【参考最低静默】低位/高位买点激活后，参考最低需 N 分钟不创新低（且不破中间/地板）才可触发限价买入。默认 120。
# 参考：设计单 §2「买点」；手写稿「120分钟内……这个数值可以在.env调整（在.env可修改）」。
REF_LOW_MINUTES=120

# 【已涨幅度有效门槛】已涨幅度(最高-最低)/最低 ≥ 本值才启用清仓1（破回撤上）；未达/为空 → 动态止盈兜底。默认 0.05（5%）。
# 参考：设计单 §3「有效性」；手写稿「持仓只有上涨超过5% 这个数值可以在.env中修改」。
RISEN_RANGE_MIN_PCT=0.05

# 【已涨幅度推送节流】已涨幅度生效推送的同键最小间隔（秒），设计单要求节流 ≥20 秒。默认 20。
# 参考：设计单 §3「推送……节流 ≥20 秒」；E3 确认。
RISEN_PUSH_THROTTLE_SEC=20

# 【清仓单重挂周期】清仓限价单未成交部分每 N 秒按最新买一撤单重挂（不主动转市价）。默认 15。
# 参考：设计单 §4「清仓单（暂定，待后续规范）」；E3 确认。注：15s 重挂属「后续补强」，代码暂未读取本键。
SELL_REPRICE_SEC=15

# 【铁律① 最大亏损底线】个股亏损 ≤ -本值 即市价止损清仓（优先于其余清仓规则；下一买点按买入类型）。默认 0.125（12.5%）。
# 参考：用户铁律「个股亏损最大亏损12.5%」。
HARD_STOP_LOSS_PCT=0.125

# 【铁律② 回本清仓门槛】持仓历史最大亏损 ≤ -本值 后，价格回到保本价（含双边手续费）即清仓。默认 0.05（5%）。
# 参考：用户铁律「个股亏损有超过5%的记录回本即清仓」。
BREAKEVEN_CLEAR_LOSS_PCT=0.05

# 【动态止盈·激活门槛】持仓盈利 ≥ 本值 才激活动态止盈（止盈价=峰值×(1-容忍)，恒有地板）。默认 0.065（6.5%）。
# 参考：设计单 §3「动态止盈兜底（现行口径：6.5% 激活）」。
TAKE_PROFIT_ACTIVATE_PCT=0.065

# 【动态止盈·立即清仓档】盈利 ≥ 本值 直接清仓（回撤容忍归零）。默认 0.20（20%）。
# 参考：设计单 §3「≥20% 立即清仓」。
TAKE_PROFIT_CLEAR_PCT=0.20

# 【动态止盈·基准容忍】激活档位的回撤容忍基准（1.5%）。容忍 = 本值 − 斜率×(盈利−激活档)，按分档取低边。默认 0.015。
# 参考：设计单 §3「容忍 1.5%−0.1%×(盈利−6.5%)」。
TAKE_PROFIT_TOLERANCE_PCT=0.015

# 【动态止盈·容忍斜率】盈利每多 1%，回撤容忍减少的幅度（0.1%）。默认 0.1。
# 参考：设计单 §3 同上（1.5%−0.1%×…）。
TAKE_PROFIT_TOLERANCE_SLOPE=0.1

# 【动态止盈·分档步长】容忍曲线的分档粒度（0.001 = 0.1%，与原 136 行硬表逐档等价）。默认 0.001。
# 参考：v5.12 R13 等价性测试（TestStopLossTable 对 profit_stop_map_v5.11.json 逐档校验）。
TAKE_PROFIT_BUCKET=0.001

# 【动态止盈·止盈价地板】止盈价下限 = 成本×(1+本值)，保证激活后离场最低盈利。默认 0.05（5%）。
# 参考：v5.4_fix「保证清仓最低5%盈利」（止盈价恒有地板）。
TAKE_PROFIT_MIN_MARGIN_PCT=0.05
