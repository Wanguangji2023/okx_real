# ==================== OKX API 凭证（v3.0 新增） ====================
# 在 OKX 官网【API管理】创建；模拟盘下单需勾选"模拟盘"权限的 Key
OKX_API_KEY=9e2ef68a-3beb-4d05-a445-e2edb9085a99
OKX_API_SECRET=D0B8DDEBE96F01E39240DD2ABCDFF0EB
OKX_API_PASSPHRASE=Ericwan8899!

# ==================== 交易模式切换 ====================
# local = 本地模拟(不下单, 仅CSV记账)
# demo  = OKX平台模拟盘(API真实下单, 默认)
# live  = OKX实盘下单
# 优先级: 此环境变量 > Excel"系统参数"表 trade_mode > 默认 demo
OKX_TRADE_MODE=demo
MIN_BUY_AMOUNT=110
COOLDOWN_DAYS=7
# 实盘二次确认：只有 =YES 时才真正进入实盘，否则自动降级为模拟盘
OKX_LIVE_CONFIRM=
INPUT_DATA=/home/ubuntu/alibaba_agent/downlaods_futu_data/data_all_market/okx/demo/计算区间/双区间相同再算幅度/标黄/已标注

# 股票池倍数层过滤（对应各 xlsx 第1个sheet"层计算"的区间列，如 8-16；
# 两位数字是倍数=本层最高/本层最低 的价差倍数，层阶梯 …4-8 / 8-16 / 16-32…）：
#   FILTER_LAYER=8-16        只要 8-16 层
#   FILTER_LAYER=8-16及以上   8-16 以上：16-32、32-64……
#   FILTER_LAYER=8-16以下     8-16 以下：4-8、2-4……
#   逗号分隔可叠加多个条件；留空 = 不过滤，全部入池
# （池子价格上下限取第2个sheet"层计算幅度"：C列=同层最低、D列=同层最高）
FILTER_LAYER=




# 选择推送方式：dingtalk / feishu / both / none
NOTIFY_CHANNEL=feishu

# 飞书（新增）
FEISHU_WEBHOOK_okx=https://open.feishu.cn/open-apis/bot/v2/hook/5fee1da3-58ba-43ab-b486-8eaaf63a27b6
FEISHU_SECRET_okx=wSjRteKJDy71neG5l0yR3g


