[Unit]
Description=okx_real_service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/okx_real/
Environment="PYTHONUNBUFFERED=1"
#ExecStart=/usr/bin/python3 /home/ubuntu/code/demo.py
ExecStart=/home/ubuntu/venv/bin/python3 /home/ubuntu/okx_real/okx_autoTrade_TrytoConnectOKX1.py
Restart=on-failure
RestartSec=600

[Install]
WantedBy=multi-user.target

